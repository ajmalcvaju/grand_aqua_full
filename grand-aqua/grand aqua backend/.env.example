# Grand Aqua Unified Backend Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Central Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/grand_aqua_db?schema=public"

# Central JWT Authentication
JWT_SECRET=grand_aqua_super_secure_jwt_secret_key_2026_dev_prod
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=grand_aqua_super_secure_refresh_key_2026_dev_prod
JWT_REFRESH_EXPIRATION=30d

# OTP Provider Configuration (Mock in development if credentials missing)
OTP_PROVIDER=mock
OTP_EXPIRY_SECONDS=300
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Payment Gateway (Razorpay / Stripe)
PAYMENT_GATEWAY_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_grandaqua_mock_key
RAZORPAY_KEY_SECRET=rzp_test_grandaqua_mock_secret
RAZORPAY_WEBHOOK_SECRET=

# Cloud Storage (S3 / Azure / Cloudinary / Local)
STORAGE_PROVIDER=local
STORAGE_UPLOAD_DIR=./uploads
AWS_S3_BUCKET=grand-aqua-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# Redis / Background Tasks (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379

# Company Defaults
COMPANY_NAME="Grand Aqua"
COMPANY_TAGLINE="Pure | Safe | Healthy - Wholesale & Retail"
COMPANY_PHONE="+91 98765 43210"
COMPANY_EMAIL="support@grandaqua.com"
COMPANY_GSTIN="07AAAAA0000A1Z5"
COMPANY_CURRENCY="INR"
